<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <TextView
            style="@style/SectionHeader"
            android:text="@string/provider_section" />

        <com.google.android.material.card.MaterialCardView style="@style/CardBlock">

            <LinearLayout style="@style/CardBody">

                <Spinner
                    android:id="@+id/providerSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />

                <TextView
                    android:id="@+id/providerStatus"
                    style="@style/RowLabel"
                    android:paddingTop="8dp"
                    android:text="@string/status_disconnected" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scanButton"
                        style="@style/ActionButton"
                        android:text="@string/scan_start" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reconnectButton"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/provider_reconnect" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/disconnectButton"
                    style="@style/ActionButton"
                    android:layout_width="match_parent"
                    android:layout_weight="0"
                    android:layout_marginTop="8dp"
                    android:text="@string/device_disconnect" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/whooshSection"
            style="@style/SectionHeader"
            android:text="@string/provider_whoosh" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/whooshCard"
            style="@style/CardBlock">

            <LinearLayout style="@style/CardBody">

                <Spinner
                    android:id="@+id/whooshModeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:hint="@string/provider_whoosh_token">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/whooshTokenInput"
                        style="@style/InputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/InputField"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:hint="@string/provider_whoosh_start_id">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/whooshStartInput"
                            style="@style/InputText" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/InputField"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:hint="@string/provider_whoosh_stop_id">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/whooshStopInput"
                            style="@style/InputText" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/whooshStartButton"
                        style="@style/ActionButton"
                        android:text="@string/provider_whoosh_start" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/whooshStopButton"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/provider_whoosh_stop" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:hint="@string/provider_whoosh_unlock_hex">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/whooshUnlockInput"
                        style="@style/InputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:hint="@string/provider_whoosh_lock_hex">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/whooshLockInput"
                        style="@style/InputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/whooshOnlineButton"
                        style="@style/ActionButton"
                        android:text="@string/provider_whoosh_send" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/whooshUnlockButton"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/control_unlock" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/whooshLockButton"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/control_lock" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/yandexSection"
            style="@style/SectionHeader"
            android:text="@string/provider_yandex" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/yandexCard"
            style="@style/CardBlock">

            <LinearLayout style="@style/CardBody">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:hint="@string/provider_yandex_key">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/yandexKeyInput"
                        style="@style/InputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:hint="@string/provider_yandex_service">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/yandexServiceInput"
                        style="@style/InputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:hint="@string/provider_yandex_write">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/yandexWriteInput"
                        style="@style/InputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:hint="@string/provider_yandex_notify">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/yandexNotifyInput"
                        style="@style/InputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:hint="@string/provider_yandex_cccd">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/yandexCccdInput"
                        style="@style/InputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/InputField"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:hint="@string/provider_yandex_device">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/yandexDeviceInput"
                            style="@style/InputText" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/InputField"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:hint="@string/provider_yandex_nonce">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/yandexNonceInput"
                            style="@style/InputText" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/yandexAuthButton"
                        style="@style/ActionButton"
                        android:text="@string/provider_yandex_auth" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/yandexLockButton"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/control_lock" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/yandexUnlockButton"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/control_unlock" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/yandexSoundButton"
                        style="@style/ActionButton"
                        android:text="@string/control_find_car" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/yandexCableButton"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/provider_yandex_cable" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/yandexBatteryButton"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/provider_yandex_battery" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:hint="@string/provider_raw_hex">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/rawInput"
                        style="@style/InputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rawButton"
                    style="@style/ActionButton"
                    android:layout_width="match_parent"
                    android:layout_weight="0"
                    android:layout_marginTop="8dp"
                    android:text="@string/provider_raw_send" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/ActionButton"
            android:layout_width="match_parent"
            android:layout_weight="0"
            android:layout_marginTop="12dp"
            android:text="@string/provider_save" />
    </LinearLayout>
</ScrollView>
