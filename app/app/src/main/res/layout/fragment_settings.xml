<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <TextView style="@style/SectionHeader" android:text="@string/settings_appearance" />

        <com.google.android.material.card.MaterialCardView style="@style/CardBlock">

            <LinearLayout style="@style/CardBody">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeButton"
                    style="@style/ActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SectionHeader" android:text="@string/settings_key" />

        <com.google.android.material.card.MaterialCardView style="@style/CardBlock">

            <LinearLayout style="@style/CardBody">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:hint="@string/control_key_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settingsKey"
                        style="@style/InputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsKeyNineHack"
                        style="@style/ActionButton"
                        android:text="@string/settings_key_ninehack" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsKeyLostBot"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/settings_key_lostbot" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SectionHeader" android:text="@string/settings_spam" />

        <com.google.android.material.card.MaterialCardView style="@style/CardBlock">

            <LinearLayout style="@style/CardBody">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView style="@style/RowLabel" android:text="@string/settings_spam_interval" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/InputField"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/settingsSpamInterval"
                            style="@style/InputText"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingsAutoResumeSpam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_auto_resume_spam"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SectionHeader" android:text="@string/settings_connection" />

        <com.google.android.material.card.MaterialCardView style="@style/CardBlock">

            <LinearLayout style="@style/CardBody">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingsAutoReconnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_auto_reconnect"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView style="@style/RowLabel" android:text="@string/settings_auto_reconnect_attempts" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/InputField"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/settingsAutoReconnectAttempts"
                            style="@style/InputText"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView style="@style/RowLabel" android:text="@string/settings_auto_reconnect_delay" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/InputField"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/settingsAutoReconnectDelay"
                            style="@style/InputText"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SectionHeader" android:text="@string/settings_scan" />

        <com.google.android.material.card.MaterialCardView style="@style/CardBlock">

            <LinearLayout style="@style/CardBody">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingsShowAllDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_show_all_devices"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingsHideUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_hide_unknown"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingsShowScanLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_show_scan_log"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingsVerboseLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_verbose_log"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsSort"
                    style="@style/ActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/scan_sort" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SectionHeader" android:text="@string/settings_ai" />

        <com.google.android.material.card.MaterialCardView style="@style/CardBlock">

            <LinearLayout style="@style/CardBody">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:hint="@string/settings_ai_base_url">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settingsAiBaseUrl"
                        style="@style/InputText"
                        android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:hint="@string/settings_ai_api_key">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settingsAiApiKey"
                        style="@style/InputText"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:hint="@string/settings_ai_model">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settingsAiModel"
                        style="@style/InputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsAiFormat"
                    style="@style/ActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_ai_format" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsAiOpen"
                    style="@style/ActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_ai_open" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SectionHeader" android:text="@string/settings_updates" />

        <com.google.android.material.card.MaterialCardView style="@style/CardBlock">

            <LinearLayout style="@style/CardBody">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingsAutoUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/settings_auto_update"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/settingsCurrentVersion"
                    style="@style/RowLabel"
                    android:paddingTop="4dp"
                    android:text="@string/settings_update_idle" />

                <TextView
                    android:id="@+id/settingsUpdateStatus"
                    style="@style/RowLabel"
                    android:paddingTop="2dp"
                    android:text="@string/settings_update_idle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateCheck"
                    style="@style/ActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_check_update" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SectionHeader" android:text="@string/settings_reports" />

        <com.google.android.material.card.MaterialCardView style="@style/CardBlock">

            <LinearLayout style="@style/CardBody">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingsReportUpload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_report_upload"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:hint="@string/settings_report_url">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settingsReportUrl"
                        style="@style/InputText"
                        android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:hint="@string/settings_report_token">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settingsReportToken"
                        style="@style/InputText"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingsReportWifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/settings_report_wifi"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/settingsReportStatus"
                    style="@style/RowLabel"
                    android:paddingTop="4dp"
                    android:text="@string/settings_report_restriction" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsReportSend"
                        style="@style/ActionButton"
                        android:text="@string/settings_report_send" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsReportRetry"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/settings_report_retry" />
                </LinearLayout>

                <TextView
                    style="@style/RowLabel"
                    android:paddingTop="8dp"
                    android:text="@string/settings_report_redaction" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/settingsAutosave"
            style="@style/RowLabel"
            android:layout_marginTop="12dp"
            android:text="@string/settings_autosave" />

        <TextView
            android:id="@+id/settingsAbout"
            style="@style/RowLabel"
            android:layout_marginTop="8dp"
            android:text="@string/settings_about" />
    </LinearLayout>
</ScrollView>
