<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/CardBlock"
        android:layout_marginTop="8dp">

        <LinearLayout style="@style/CardBody">

            <TextView
                android:id="@+id/gattDevice"
                style="@style/ValueText"
                android:layout_width="match_parent"
                android:text="@string/gatt_wait"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gattStatus"
                style="@style/RowLabel"
                android:layout_width="match_parent"
                android:paddingTop="6dp"
                android:text="@string/gatt_hint" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gattList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gattCopy"
            style="@style/ActionButton"
            android:text="@string/gatt_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gattReconnect"
            style="@style/ActionButton"
            android:layout_marginStart="8dp"
            android:text="@string/gatt_reconnect" />
    </LinearLayout>
</LinearLayout>
